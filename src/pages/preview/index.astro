---
import Layout from '../../layouts/Layout.astro';
import { labOptions, pageOrder } from '../../data/labOptions';
import { seo } from '../../data/program';
---

<Layout
  title="Opsi Penempatan Signature Lab | Preview"
  description="Perbandingan lima opsi penempatan Signature Lab di halaman program Bisnis Digital."
  canonical={seo.canonical}
  noindex
>
  <main class="pv">
    <header class="pv-head">
      <h1>Opsi Penempatan Signature Lab</h1>
      <p>
        Lima opsi letak section Marketing Lab di halaman program Bisnis Digital. Isi section sama di semua opsi, yang
        beda hanya posisinya. Klik tiap opsi untuk melihat halaman utuhnya.
      </p>
    </header>

    <ol class="pv-list">
      {
        labOptions.map((o) => (
          <li class:list={['pv-opt', { 'pv-opt--rec': o.recommended }]}>
            <div class="pv-opt-head">
              <span class="pv-letter">{o.letter}</span>
              <div>
                <h2>
                  {o.name}
                  {o.recommended && <span class="pv-badge">Rekomendasi</span>}
                </h2>
                <p>{o.summary}</p>
              </div>
            </div>

            <div class="pv-strip" role="img" aria-label={`Urutan section untuk opsi ${o.letter}`}>
              {o.after === null && <span class="pv-block pv-block--lab pv-block--band">Signature Lab</span>}
              {pageOrder.map((s) => (
                <>
                  <span class="pv-block">{s.label}</span>
                  {o.after === s.key && <span class="pv-block pv-block--lab">Signature Lab</span>}
                </>
              ))}
            </div>

            <div class="pv-cols">
              <div>
                <h3>Kelebihan</h3>
                <ul>{o.pros.map((t) => <li>{t}</li>)}</ul>
              </div>
              <div>
                <h3>Kekurangan</h3>
                <ul>{o.cons.map((t) => <li>{t}</li>)}</ul>
              </div>
            </div>

            <a class="pv-link" href={`/preview/${o.slug}`}>Lihat halaman Opsi {o.letter}</a>
          </li>
        ))
      }
    </ol>

    <footer class="pv-foot">
      <p>
        Halaman asli tanpa lab:{' '}
        <a href="/program/bisnis-digital">/program/bisnis-digital</a>
      </p>
    </footer>
  </main>
</Layout>

<style>
  .pv {
    --pv-blue: var(--color-dark-bg-dark);
    --pv-gold: var(--color-accent-yellow);
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 20px 72px;
    font-family: var(--font-body, Manrope, sans-serif);
    color: var(--color-grey-800);
    background: #fff;
    min-height: 100vh;
  }
  .pv-head h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    color: var(--pv-blue);
    line-height: 1.15;
  }
  .pv-head p {
    margin-top: 12px;
    max-width: 62ch;
    line-height: 1.6;
  }
  .pv-list {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pv-opt {
    padding: 24px;
    border-radius: 10px;
    border: 1px solid var(--color-grey-200);
    background: #fff;
  }
  .pv-opt--rec {
    border-color: var(--pv-blue);
    box-shadow: 0 10px 28px rgba(1, 72, 96, 0.12);
  }
  .pv-opt-head {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .pv-letter {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: #fff;
    background: var(--pv-blue);
  }
  .pv-opt-head h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: var(--color-black);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .pv-opt-head p {
    margin-top: 4px;
    line-height: 1.55;
    font-size: 15px;
  }
  .pv-badge {
    font-family: var(--font-body, Manrope, sans-serif);
    font-size: 12px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 9999px;
    background: var(--pv-gold);
    color: #fff;
  }
  .pv-strip {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pv-block {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    line-height: 1.2;
    background: var(--color-grey-100, #f4f4f4);
    border: 1px solid var(--color-grey-200);
    color: var(--color-grey-800);
  }
  .pv-block--lab {
    background: var(--pv-blue);
    border-color: var(--pv-blue);
    color: #fff;
    font-weight: 700;
  }
  .pv-block--band {
    flex-basis: 100%;
    text-align: center;
    padding: 10px;
  }
  .pv-cols {
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 768px) {
    .pv-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
  .pv-cols h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-black);
  }
  .pv-cols ul {
    margin: 8px 0 0;
    padding-left: 18px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    line-height: 1.5;
  }
  .pv-link {
    display: inline-block;
    margin-top: 22px;
    padding: 10px 18px;
    border-radius: 9999px;
    background: var(--pv-blue);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .pv-link:hover,
  .pv-link:focus-visible {
    background: #0b617f;
  }
  .pv-foot {
    margin-top: 36px;
    font-size: 14px;
  }
  .pv-foot a {
    color: var(--pv-blue);
    font-weight: 700;
  }
</style>
