---
import ProgramPage from '../../components/ProgramPage.astro';
import { labOptions } from '../../data/labOptions';

export function getStaticPaths() {
  return labOptions.map((option) => ({ params: { option: option.slug }, props: { option } }));
}

const { option } = Astro.props;
---

<ProgramPage labPosition={option.position} noindex title={`Opsi ${option.letter}: ${option.name} | Preview`} />
