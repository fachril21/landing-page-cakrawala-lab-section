---
import Icon from '../Icon.astro';
import type { LabContent } from '../../data/lab';

interface Props {
  lab: LabContent;
}
const { lab } = Astro.props;
---

<div class="lk">
  <header>
    <h3 class="lab-title lk-name">{lab.name}</h3>
    <p class="lab-desc">{lab.description}</p>
  </header>

  <div>
    <h4 class="lab-h4">{lab.work.title}</h4>
    <ul class="lk-cols">
      {
        lab.work.items.map((item) => (
          <li class="lk-col">
            <div class="lab-icon lk-icon">
              <Icon icon={item.icon} />
            </div>
            <div>
              <p class="lk-title">{item.title}</p>
              <p class="lk-text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="lk-proof">
    <h4 class="lk-proof-title">{lab.proof.title}</h4>
    <ul class="lk-proof-list">
      {
        lab.proof.items.map((item) => (
          <li class="lk-proof-row">
            <div class="lk-proof-icon">
              <Icon icon={item.icon} />
            </div>
            <div>
              <p class="lk-proof-name">{item.title}</p>
              <p class="lk-proof-text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lk {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .lk-name {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .lk-cols {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .lk-col {
    display: flex;
    gap: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--lab-line);
  }
  .lk-icon {
    background: #fff;
    border: 1px solid var(--lab-blue);
  }
  .lk-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-black);
  }
  .lk-text {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--lab-ink);
  }
  .lk-proof {
    padding: 24px 20px;
    border-radius: 10px;
    color: #fff;
    background: var(--lab-blue) url(/images/program/bg-job-opportunity.png) no-repeat left / cover;
  }
  .lk-proof-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.25;
    color: #fff;
    max-width: 18ch;
  }
  .lk-proof-list {
    margin-top: 16px;
  }
  .lk-proof-row {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .lk-proof-icon {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    background: rgba(255, 255, 255, 0.14);
    color: var(--lab-gold);
  }
  .lk-proof-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: #fff;
  }
  .lk-proof-text {
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--lab-on-blue);
  }
  @media (min-width: 768px) {
    .lk-cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    .lk-col {
      flex-direction: column;
      gap: 14px;
    }
    .lk-proof {
      display: grid;
      grid-template-columns: 4fr 7fr;
      gap: 32px;
      padding: 32px 28px;
    }
    .lk-proof-list {
      margin-top: 0;
    }
    .lk-proof-row:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
