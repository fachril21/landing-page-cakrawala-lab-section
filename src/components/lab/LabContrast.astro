---
import Icon from '../Icon.astro';
import type { LabContent } from '../../data/lab';

interface Props {
  lab: LabContent;
}
const { lab } = Astro.props;

const cards = [
  { key: 'work', title: lab.work.title, items: lab.work.items },
  { key: 'proof', title: lab.proof.title, items: lab.proof.items },
];
---

<div class="lc">
  <header>
    <h3 class="lab-title lc-name">{lab.name}</h3>
    <p class="lab-desc">{lab.description}</p>
  </header>

  <div class="lc-grid">
    {
      cards.map((card) => (
        <section class:list={['lc-card', { 'lc-card--dark': card.key === 'proof' }]}>
          <h4 class="lc-card-title">{card.title}</h4>
          <ul class="lc-list">
            {card.items.map((item) => (
              <li class="lc-row">
                <div class="lab-icon">
                  <Icon icon={item.icon} />
                </div>
                <div>
                  <p class="lc-title">{item.title}</p>
                  <p class="lc-text">{item.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<style>
  .lc {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .lc-name {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .lc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .lc-card {
    padding: 24px 20px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--lab-line);
    box-shadow:
      0 1px 2px rgba(1, 72, 96, 0.06),
      0 10px 28px rgba(1, 72, 96, 0.08);
  }
  .lc-card--dark {
    color: #fff;
    border-color: transparent;
    background: var(--lab-blue) url(/images/program/bg-job-opportunity.png) no-repeat left / cover;
  }
  .lc-card-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    color: var(--color-black);
  }
  .lc-card--dark .lc-card-title {
    color: #fff;
  }
  .lc-list {
    margin-top: 12px;
  }
  .lc-row {
    display: flex;
    gap: 14px;
    padding: 16px 0;
    border-top: 1px solid var(--lab-line);
  }
  .lc-row:first-child {
    border-top: 0;
  }
  .lc-card--dark .lc-row {
    border-top-color: rgba(255, 255, 255, 0.18);
  }
  .lc-card--dark .lab-icon {
    background: rgba(255, 255, 255, 0.14);
    color: var(--lab-gold);
  }
  .lc-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.3;
    color: var(--color-black);
  }
  .lc-card--dark .lc-title {
    color: #fff;
  }
  .lc-text {
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--lab-ink);
  }
  .lc-card--dark .lc-text {
    color: var(--lab-on-blue);
  }
  @media (min-width: 768px) {
    .lc-grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .lc-card {
      padding: 28px 24px;
    }
  }
</style>
