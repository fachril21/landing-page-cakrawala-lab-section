---
import Icon from '../Icon.astro';
import type { LabContent } from '../../data/lab';

interface Props {
  lab: LabContent;
}
const { lab } = Astro.props;

const panels = [
  { id: 'work', label: lab.work.title, items: lab.work.items },
  { id: 'proof', label: lab.proof.title, items: lab.proof.items },
];
---

<div class="lt" data-lab-tabs>
  <header>
    <h3 class="lab-title lt-name">{lab.name}</h3>
    <p class="lab-desc">{lab.description}</p>
  </header>

  <div class="lt-card">
    <div class="lt-tablist" role="tablist" aria-label={lab.name}>
      {
        panels.map((p, i) => (
          <button
            type="button"
            role="tab"
            class="lt-tab"
            id={`lab-tab-${p.id}`}
            aria-controls={`lab-panel-${p.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {p.label}
          </button>
        ))
      }
    </div>
    {
      panels.map((p) => (
        <div role="tabpanel" class="lt-panel" id={`lab-panel-${p.id}`} aria-labelledby={`lab-tab-${p.id}`}>
          <ul class="lt-items">
            {p.items.map((item) => (
              <li class="lt-item">
                <div class="lab-icon">
                  <Icon icon={item.icon} />
                </div>
                <p class="lt-item-title">{item.title}</p>
                <p class="lt-item-text">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<style>
  .lt {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .lt-name {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .lt-card {
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--lab-line);
    box-shadow:
      0 1px 2px rgba(1, 72, 96, 0.06),
      0 10px 28px rgba(1, 72, 96, 0.1);
  }
  .lt-tablist {
    display: flex;
    background: var(--lab-tint);
  }
  .lt-tab {
    flex: 1 1 0;
    padding: 16px 12px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.3;
    color: var(--lab-ink);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .lt-tab:hover {
    color: var(--lab-blue);
  }
  .lt-tab[aria-selected='true'] {
    background: #fff;
    color: var(--lab-blue);
    border-bottom-color: var(--lab-gold);
  }
  .lt-tab:focus-visible {
    outline: 2px solid var(--lab-gold);
    outline-offset: -4px;
  }
  .lt-items {
    display: grid;
    grid-template-columns: 1fr;
  }
  .lt-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: 14px;
    align-items: start;
    padding: 18px 20px;
    border-top: 1px solid var(--lab-line);
  }
  .lt-item:first-child {
    border-top: 0;
  }
  .lt-item .lab-icon {
    grid-row: span 2;
  }
  .lt-item-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.3;
    color: var(--color-black);
  }
  .lt-item-text {
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--lab-ink);
  }
  @media (min-width: 768px) {
    .lt-tab {
      font-size: 16px;
      padding: 18px 16px;
    }
    .lt-items {
      grid-template-columns: repeat(3, 1fr);
    }
    .lt-item {
      display: block;
      padding: 24px;
      border-top: 0;
      border-left: 1px solid var(--lab-line);
    }
    .lt-item:first-child {
      border-left: 0;
    }
    .lt-item .lab-icon {
      margin-bottom: 14px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lab-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        const step = event.key === 'ArrowRight' ? 1 : -1;
        select((i + step + tabs.length) % tabs.length, true);
        event.preventDefault();
      });
    });
    select(0);
  });
</script>
