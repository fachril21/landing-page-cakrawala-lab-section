---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import ProgramHero from './ProgramHero.astro';
import SidenavProgram from './SidenavProgram.astro';
import Overview from './sections/Overview.astro';
import WhyDepartment from './sections/WhyDepartment.astro';
import Curriculum from './sections/Curriculum.astro';
import JobOpportunity from './sections/JobOpportunity.astro';
import LearningOutcomes from './sections/LearningOutcomes.astro';
import Skills from './sections/Skills.astro';
import Testimony from './sections/Testimony.astro';
import Faq from './sections/Faq.astro';
import CtaBanner from './sections/CtaBanner.astro';
import LabSection from './lab/LabSection.astro';
import ShowcaseSection from './lab/ShowcaseSection.astro';
import TweakPanel from './lab/TweakPanel.astro';
import FloatingWhatsapp from './FloatingWhatsapp.astro';
import Footer from './Footer.astro';
import { seo, sidenavItems } from '../data/program';
import { marketingLab } from '../data/lab';

interface Props {
  /** Show the Marketing Lab section (and showcase) right after Kurikulum. Omit for the real page. */
  lab?: boolean;
  /** Show the Tweak panel and render every design variant so it can switch between them. */
  tweak?: boolean;
  noindex?: boolean;
  title?: string;
}

const { lab = false, tweak = false, noindex = false, title = seo.title } = Astro.props;

const labItem = { id: marketingLab.sectionId, title: marketingLab.navTitle };
const navItems = lab
  ? sidenavItems.flatMap((item) => (item.id === 'curriculum' ? [item, labItem] : [item]))
  : sidenavItems;
---

<Layout title={title} description={seo.description} canonical={seo.canonical} noindex={noindex}>
  <div class="bg-grey-100">
    <Navbar />
    <ProgramHero />
    <div class="max-w-[1040px] mx-auto lg:pt-5 pb-6 md:pb-10 overflow-x-hidden px-5 xl:px-0">
      <div class="flex flex-col lg:flex-row w-full min-w-0 justify-between lg:gap-5" id="ProgramSection">
        <SidenavProgram items={navItems} />
        <div class="flex-1 min-w-0 max-w-[calc(1040px_-_40px_-_245px)] pt-6 px-4 md:px-0 md:pt-0 pb-6 md:pb-0">
          <div class="flex flex-col items-start gap-10">
            <Overview />
            <WhyDepartment />
            <Curriculum />
            {lab && <LabSection all={tweak} />}
            {lab && <ShowcaseSection all={tweak} />}
            <JobOpportunity />
            <LearningOutcomes />
            <Skills />
            <Testimony />
            <Faq />
            <CtaBanner />
          </div>
        </div>
      </div>
    </div>
    <FloatingWhatsapp />
    {tweak && <TweakPanel />}
    <div></div>
    <Footer />
  </div>
</Layout>
