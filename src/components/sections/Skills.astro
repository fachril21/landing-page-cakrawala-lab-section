---
import Icon from '../Icon.astro';
import { skills, CDN } from '../../data/program';

const CARD_SHADOW =
  'box-shadow: 7px 81px 23px 0px rgba(0, 0, 0, 0.00), 4px 52px 21px 0px rgba(0, 0, 0, 0.01), 2px 29px 18px 0px rgba(0, 0, 0, 0.05), 1px 13px 13px 0px rgba(0, 0, 0, 0.09), 0px 3px 7px 0px rgba(0, 0, 0, 0.10);';

const groups = [
  {
    label: 'Soft Skill',
    icon: 'bx:user-voice',
    panelBg: 'bg-primary-100',
    iconColor: 'text-black',
    labelColor: 'text-primary-900',
    scrollbar: 'slider-scrollbar-program-soft',
    cardBg: `bg-cakrawala-blue text-grey-100 flex flex-col gap-2.5 items-start p-5 rounded-[10px] bg-[url(${CDN}/bg-term-admission.png)] bg-no-repeat bg-right-top w-[350px] shrink-0`,
    items: skills.soft,
  },
  {
    label: 'Hard Skill',
    icon: 'bx:cog',
    panelBg: 'bg-accent-100',
    iconColor: 'text-accent-800',
    labelColor: 'text-accent-800',
    scrollbar: 'slider-scrollbar-program-hard',
    cardBg: `bg-cakrawala-gold-light text-grey-100 flex flex-col gap-2.5 items-start p-5 rounded-[10px] bg-[url(${CDN}/square-bg2.webp)] bg-no-repeat bg-right-top w-[350px] shrink-0`,
    items: skills.hard,
  },
];
---

<div class="flex flex-col gap-2.5 items-start w-full" id="skills">
  <h3 class="font-bold text-2xl lg:text-[34px] font-heading text-cakrawala-blue">{skills.title}</h3>
  {
    groups.map((group) => (
      <div
        class={`flex flex-col md:flex-row gap-[20px] overflow-auto items-start md:items-center rounded-[10px] ${group.panelBg} px-[20px] py-[20px] md:py-[40px] w-full`}
      >
        <div class="flex flex-row md:flex-col gap-[5px] md:gap-0 items-center md:items-start">
          <div class={group.iconColor}>
            <Icon size="text-[20px] md:text-[40px]" icon={group.icon} />
          </div>
          <p class={`text-base md:text-2xl ${group.labelColor} font-semibold truncate shrink-0`}>{group.label}</p>
        </div>
        <div class={`flex w-full gap-2.5 overflow-x-auto ${group.scrollbar} rounded-[10px] pb-2.5`}>
          {group.items.map((item) => (
            <div class={group.cardBg} style={CARD_SHADOW}>
              <div class="flex flex-col items-start gap-2.5">
                <p class="text-base font-bold font-heading">{item.title}</p>
                <p class="text-sm font-manrope">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
