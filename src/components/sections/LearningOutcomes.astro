---
import Icon from '../Icon.astro';
import { learningOutcomes, CDN } from '../../data/program';

const CARD_SHADOW =
  'box-shadow: 7px 81px 23px 0px rgba(0, 0, 0, 0.00), 4px 52px 21px 0px rgba(0, 0, 0, 0.01), 2px 29px 18px 0px rgba(0, 0, 0, 0.05), 1px 13px 13px 0px rgba(0, 0, 0, 0.09), 0px 3px 7px 0px rgba(0, 0, 0, 0.10);';
---

<section class="flex flex-col gap-2.5 items-start w-full" id="achievement">
  <h3 class="font-bold text-2xl lg:text-[34px] font-heading text-cakrawala-blue">{learningOutcomes.title}</h3>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
    {
      learningOutcomes.items.map((outcome) => (
        <div
          class={`bg-cakrawala-gold-light text-grey-100 flex flex-col gap-2.5 items-start p-5 rounded-[10px] bg-[url(${CDN}/square-bg2.webp)] bg-no-repeat bg-right-top w-full bg-contain`}
          style={CARD_SHADOW}
        >
          <div class="flex flex-col justify-between gap-5 w-full h-full">
            <div class="flex flex-col items-start gap-2.5 w-full">
              <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                <Icon icon={outcome.icon} size="text-2xl" />
              </div>
              <p class="text-base font-bold">{outcome.title}</p>
            </div>
            <div data-outcome>
              <button
                class="px-5 py-3 rounded-2xl text-white font-semibold w-full border-2 border-white text-sm"
                data-outcome-open
              >
                Lihat Detail
              </button>
              <div
                class="fixed inset-0 bg-black bg-opacity-25 backdrop-blur-sm flex justify-center items-center z-[200]"
                style="display:none"
                data-outcome-modal
              >
                <div class="bg-white rounded-lg max-w-[400px]">
                  <div class="flex items-center gap-5 p-5 justify-between">
                    <div class="flex items-center gap-4">
                      <p class="text-base font-bold text-black">{outcome.title}</p>
                    </div>
                    <div class="cursor-pointer" data-outcome-close>
                      <Icon icon="solar:close-circle-broken" size="text-base lg:text-[24px]" color="#404B5A" />
                    </div>
                  </div>
                  <div class="flex flex-col gap-4 px-5 pb-5">
                    <div class="flex flex-col gap-2.5 max-h-[400px] overflow-auto">
                      {outcome.aspects.map(([number, text]) => (
                        <>
                          <div class="flex flex-col gap-[5px]">
                            <p class="font-semibold text-black">{number}</p>
                            <p class="text-sm text-black">{text}</p>
                          </div>
                          <div class="h-[1px] bg-grey-200" />
                        </>
                      ))}
                      <div class="flex flex-col gap-[5px]">
                        {/* The original has no "reference" label translation, so this heading renders empty. */}
                        <p class="font-semibold text-black" />
                        <p class="text-sm text-black">{outcome.reference}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll('[data-outcome]').forEach((root) => {
    const modal = root.querySelector<HTMLElement>('[data-outcome-modal]');
    if (!modal) return;
    root.querySelector('[data-outcome-open]')?.addEventListener('click', () => (modal.style.display = ''));
    root.querySelector('[data-outcome-close]')?.addEventListener('click', () => (modal.style.display = 'none'));
  });
</script>
