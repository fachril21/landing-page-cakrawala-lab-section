---
import Icon from '../Icon.astro';
import { whyDepartment } from '../../data/program';
---

<section class="flex flex-col gap-5 items-start w-full" id="whyDepartment">
  <h3 class="font-bold text-2xl lg:text-[34px] font-heading text-cakrawala-blue">{whyDepartment.title}</h3>
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 lg:gap-x-5 lg:gap-y-5 justify-items-center">
    {
      whyDepartment.items.map((item) => (
        <div class="flex flex-col gap-2.5 bg-white border border-grey-200 p-5 rounded-[10px]">
          <Icon icon={item.icon} size="text-[35px]" color="var(--color-accent-yellow)" />
          <div class="flex flex-col gap-[5px]">
            <p class="font-semibold text-black font-manrope text-sm lg:text-base">{item.title}</p>
            {/* Empty paragraphs mirror how browsers split the CMS's nested <p> markup. */}
            <p class="text-grey-800 font-rubik text-sm lg:text-base" />
            <p set:html={item.html} />
            <p />
          </div>
        </div>
      ))
    }
  </div>
</section>
