---
import Icon from '../Icon.astro';
import WhatsappLink from '../WhatsappLink.astro';
import { cta, program, CDN, REGISTER_URL } from '../../data/program';

const CARD_SHADOW =
  'box-shadow: 7px 81px 23px 0px rgba(0, 0, 0, 0.00), 4px 52px 21px 0px rgba(0, 0, 0, 0.01), 2px 29px 18px 0px rgba(0, 0, 0, 0.05), 1px 13px 13px 0px rgba(0, 0, 0, 0.09), 0px 3px 7px 0px rgba(0, 0, 0, 0.10);';
---

<section
  class={`bg-cakrawala-blue text-white p-5 rounded-[10px] bg-[url(${CDN}/cta-bg-mobile.png)] lg:bg-[url(${CDN}/cta-bg.png)] bg-no-repeat bg-right w-full bg-contain`}
  style={CARD_SHADOW}
  id="term"
>
  <div class="flex flex-col gap-2.5 max-w-[400px]">
    <h3 class="font-heading font-semibold text-2xl">{cta.title}</h3>
    <p class="text-grey-200">{cta.description}</p>
    <div class="flex flex-col lg:flex-row items-center gap-2.5 w-full lg:w-fit">
      <a href={REGISTER_URL} target="_blank" style="text-decoration:none" class="w-full lg:w-fit button-register-admission">
        <button
          id="button-cosultation-bootcamp"
          class="w-full px-4 py-[13px] rounded-xl text-xs font-bold bg-gold hover:bg-gold/90 text-primary"
        >
          Daftar Sekarang
        </button>
      </a>
      <WhatsappLink message={program.whatsappMessage}>
        <button
          id="button-cosultation-bootcamp"
          class="w-full lg:w-fit bg-transparent border-2 px-4 py-[10px] rounded-xl text-xs font-bold button-cosultation-admission flex items-center border-gold hover:bg-gold/10 text-gold"
        >
          <div class="flex justify-center items-center gap-[5px] w-full">
            <Icon icon="bxl:whatsapp" size="text-[18px]" />
            <span>Hubungi Tim Admisi</span>
          </div>
        </button>
      </WhatsappLink>
    </div>
  </div>
</section>
