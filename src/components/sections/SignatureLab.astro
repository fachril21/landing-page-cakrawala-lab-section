---
import Icon from '../Icon.astro';
import { signatureLab as lab, type LabVariant } from '../../data/signatureLab';

interface Props {
  /** `column` sits inside the content column; `band` is a full-width block outside it. */
  variant?: LabVariant;
}

const { variant = 'column' } = Astro.props;
---

<section id={lab.sectionId} class={`sl sl--${variant}`}>
  <div class="sl-inner">
    <header class="sl-head">
      <h3 class="sl-title font-bold text-2xl lg:text-[34px] font-heading">{lab.title}</h3>
      <p class="sl-key">{lab.keyMessage}</p>
      <p class="sl-intro">{lab.intro}</p>
    </header>

    <div class="sl-card">
      <div class="sl-lab">
        <h4 class="sl-lab-name">{lab.lab.name}</h4>
        <p class="sl-lab-tagline">{lab.lab.tagline}</p>
        <blockquote class="sl-hook">&ldquo;{lab.lab.hook}&rdquo;</blockquote>
      </div>

      <div class="sl-detail">
        <div class="sl-panel sl-work">
          <h4 class="sl-panel-title">{lab.work.title}</h4>
          <p class="sl-panel-lead">{lab.work.lead}</p>
          <ol class="sl-steps">
            {
              lab.work.steps.map((step) => (
                <li class="sl-step">
                  <span class="sl-icon">
                    <Icon icon={step.icon} size="text-[20px]" />
                  </span>
                  <span class="sl-step-body">
                    <strong>{step.title}</strong>
                    <span>{step.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="sl-panel sl-proof">
          <h4 class="sl-panel-title">{lab.proof.title}</h4>
          <p class="sl-panel-lead">{lab.proof.lead}</p>
          <ul class="sl-proof-list">
            {
              lab.proof.items.map((item) => (
                <li>
                  <span class="sl-icon">
                    <Icon icon={item.icon} size="text-[20px]" />
                  </span>
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <ul class="sl-facts">
      {
        lab.facts.map((fact) => (
          <li>
            <strong>{fact.value}</strong>
            <span>{fact.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sl {
    --sl-blue: var(--color-dark-bg-dark);
    --sl-gold: var(--color-accent-yellow);
    --sl-ink: var(--color-grey-800);
    --sl-line: var(--color-grey-200);
    --sl-tint: #dcf5fb;
    --sl-on-blue: #cfe6ee;
    width: 100%;
  }
  .sl-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sl-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sl-title {
    color: var(--sl-blue);
  }
  .sl-key {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.35;
    color: var(--color-black);
    text-wrap: balance;
  }
  .sl-intro {
    font-size: 14px;
    line-height: 1.6;
    color: var(--sl-ink);
    max-width: 68ch;
  }
  @media (min-width: 1024px) {
    .sl-intro {
      font-size: 16px;
    }
    .sl-key {
      font-size: 20px;
    }
  }

  /* Card: dark lab header over a light detail area. */
  .sl-card {
    margin-top: 10px;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--sl-line);
    box-shadow:
      0 1px 2px rgba(1, 72, 96, 0.06),
      0 10px 28px rgba(1, 72, 96, 0.1);
  }
  .sl-lab {
    padding: 28px 20px;
    color: #fff;
    background: var(--sl-blue) url(/images/program/bg-job-opportunity.png) no-repeat left / cover;
  }
  .sl-lab-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .sl-lab-tagline {
    margin-top: 10px;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--sl-on-blue);
  }
  .sl-hook {
    margin-top: 22px;
    max-width: 30ch;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
    color: var(--sl-gold);
    text-wrap: balance;
  }

  .sl-detail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px;
  }
  @media (min-width: 768px) {
    .sl-lab {
      padding: 32px 28px;
    }
    .sl-detail {
      grid-template-columns: 1.15fr 1fr;
      gap: 28px;
      padding: 28px;
    }
  }

  .sl-panel-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-black);
  }
  .sl-panel-lead {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--sl-ink);
  }
  .sl-steps,
  .sl-proof-list {
    margin-top: 16px;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .sl-step {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid var(--sl-line);
  }
  .sl-step:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .sl-step-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--sl-ink);
  }
  .sl-step-body strong {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--color-black);
  }
  .sl-icon {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--sl-tint);
    color: var(--sl-blue);
  }
  .sl-proof {
    align-self: start;
    padding: 20px;
    border-radius: 10px;
    background: var(--color-surface);
    border: 1px solid var(--sl-line);
  }
  .sl-proof-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    border-top: 1px solid var(--sl-line);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-black);
  }
  .sl-proof-list li:first-child {
    border-top: 0;
  }

  /* Proof points as one quiet line of facts, not a stat grid. */
  .sl-facts {
    margin-top: 10px;
    list-style: none;
    padding: 14px 20px;
    border-radius: 10px;
    background: var(--sl-tint);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
  .sl-facts li {
    font-size: 14px;
    line-height: 1.5;
    color: var(--sl-ink);
  }
  .sl-facts strong {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--sl-blue);
    margin-right: 4px;
  }

  /* Band: full-bleed variant that lives outside the content column. */
  .sl--band {
    padding: 48px 20px;
    color: #fff;
    background: linear-gradient(90deg, #014860 38%, #0b617f 100%);
  }
  .sl--band .sl-inner {
    max-width: 1040px;
    margin: 0 auto;
    gap: 28px;
  }
  .sl--band .sl-title {
    color: #fff;
  }
  .sl--band .sl-key {
    color: var(--sl-gold);
  }
  .sl--band .sl-intro {
    color: var(--sl-on-blue);
  }
  .sl--band .sl-card {
    margin: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    overflow: visible;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .sl--band .sl-lab {
    padding: 0;
    background: none;
  }
  .sl--band .sl-detail {
    padding: 0;
    grid-template-columns: 1fr;
  }
  .sl--band .sl-panel {
    padding: 20px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .sl--band .sl-panel-title,
  .sl--band .sl-step-body strong,
  .sl--band .sl-proof-list li {
    color: #fff;
  }
  .sl--band .sl-panel-lead,
  .sl--band .sl-step-body {
    color: var(--sl-on-blue);
  }
  .sl--band .sl-step,
  .sl--band .sl-proof-list li {
    border-color: rgba(255, 255, 255, 0.16);
  }
  .sl--band .sl-icon {
    background: rgba(255, 255, 255, 0.14);
    color: var(--sl-gold);
  }
  .sl--band .sl-facts {
    margin: 0;
    padding: 18px 0 0;
    border-radius: 0;
    background: none;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  .sl--band .sl-facts li {
    color: var(--sl-on-blue);
  }
  .sl--band .sl-facts strong {
    color: #fff;
  }
  @media (min-width: 1024px) {
    .sl--band {
      padding: 64px 20px;
    }
    .sl--band .sl-inner {
      display: grid;
      grid-template-columns: 5fr 7fr;
      column-gap: 48px;
      row-gap: 32px;
    }
    .sl--band .sl-card {
      display: contents;
    }
    .sl--band .sl-head {
      grid-column: 1;
      grid-row: 1;
    }
    .sl--band .sl-lab {
      grid-column: 1;
      grid-row: 2;
    }
    .sl--band .sl-detail {
      grid-column: 2;
      grid-row: 1 / span 2;
      gap: 16px;
    }
    .sl--band .sl-facts {
      grid-column: 1 / -1;
      grid-row: 3;
    }
  }
</style>
